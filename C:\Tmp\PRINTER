   307  10    5:D     1 PROCEDURE CHANGENAME(VAR F:PHYLE; T:STRING);
   308  10    5:D    44 (* Change the title of F to T.  Note: (1) The file F must be closed with
   309  10    5:D    44    CLOSE(F,LOCK), and (2) this code relies on a "special feature" in the
   310  10    5:D    44    I/O subsystem, namely when the year is set to 100 the title gets updated
   311  10    5:D    44    when the file is closed *)
   312  10    5:D    44 VAR
   313  10    5:D    44   COLON: INTEGER;
   314  10    5:D    45   D: DATEREC;
   315  10    5:D    46   FIBPA: PACKED ARRAY [0..57] OF CHAR;
   316  10    5:0     0 BEGIN
   317  10    5:0     0   (* Make sure that the filename doesn't include the volume name (or "*") *)
   318  10    5:1     0   COLON:=POS(':',T);
   319  10    5:1    18   IF COLON>0 THEN DELETE(T,1,COLON);
   320  10    5:1    32   IF T[1]='*' THEN DELETE(T,1,1);
   321  10    5:1    47   MOVELEFT(F,FIBPA,58); (* Transfers the FIB for the file F to FIBPA *)
   322  10    5:1    55   MOVELEFT(T,FIBPA[38],16);
   323  10    5:1    64   WITH D DO BEGIN DAY:=2; MONTH:=3; YEAR:=100 END;
   324  10    5:1    82   MOVELEFT(D,FIBPA[56],2);
   325  10    5:1    91   MOVELEFT(FIBPA,F,58)
   326  10    5:0    99 END;
