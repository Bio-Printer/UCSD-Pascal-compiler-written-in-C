   250  10    3:D     1 PROCEDURE CLEANTITLE(VAR T:STRING);
   251  10    3:D     2 (* Attaches the default '.TEXT' to the end of the filename if necessary.
   252  10    3:D     2    A name is used exactly as given -- no .TEXT added, backup file NAME.BACK
   253  10    3:D     2    -- when it
   254  10    3:D     2      ends in '.'   (NAME. is exactly NAME: the usual UCSD convention),
   255  10    3:D     2      ends in .C or .H (a C source or header file), or
   256  10    3:D     2      is the workfile just selected with the Filer's G(et and does not end
   257  10    3:D     2      in .TEXT (for example a batch file with no suffix). *)
   258  10    3:D     2 VAR
   259  10    3:D     2   L: INTEGER;
   260  10    3:D     3   EXACT: BOOLEAN;
   261  10    3:0     0 BEGIN
   262  10    3:1     0   FOR I:=1 TO LENGTH(T) DO T[I]:=UCLC(T[I]);
   263  10    3:1    41   L:=LENGTH(T);
   264  10    3:1    46   EXACT:=FALSE;
   265  10    3:1    49   IF (L>1) AND (T[L]='.') THEN
   266  10    3:2    60     BEGIN
   267  10    3:3    60       DELETE(T,L,1);
   268  10    3:3    66       EXACT:=TRUE
   269  10    3:2    66     END
   270  10    3:1    69   ELSE
   271  10    3:2    71     IF (L>2) AND (T[L-1]='.') AND ((T[L]='C') OR (T[L]='H')) THEN
   272  10    3:3    96       EXACT:=TRUE
   273  10    3:2    96     ELSE
   274  10    3:3   101       IF USERINFO.GOTSYM AND
   275  10    3:3   104          (T=CONCAT(USERINFO.SYMVID,':',USERINFO.SYMTID)) THEN
   276  10    3:4   143         EXACT:=NOT ((L>=5) AND (POS('.TEXT',T)=L-4));
   277  10    3:1   168   IF EXACT THEN
   278  10    3:2   171     BEGIN
   279  10    3:3   171       WFNAME:=T;
   280  10    3:3   177       BACKFNAME:=CONCAT(T,'.BACK')
   281  10    3:2   206     END
   282  10    3:1   208   ELSE
   283  10    3:2   210     BEGIN
   284  10    3:3   210       IF (POS('.TEXT',T)=LENGTH(T)-4) AND (LENGTH(T)>=5) THEN
   285  10    3:4   238         DELETE(T,LENGTH(T)-4,5);
   286  10    3:3   248       WFNAME:=CONCAT(T,'.TEXT');
   287  10    3:3   279       BACKFNAME:=CONCAT(T,'.BACK')
   288  10    3:2   308     END
   289  10    3:0   310 END;
